[run]
# Optional.
# Format: "PlayerName" or "PlayerName,uuid-without-dashes"
mc_user = "DevPlayer,00000000000000000000000000000001"

[build]
# Optional local toggle for the legacy formal-version increment flow.
formal_version = false

[publish]
# Optional local-only credential fallbacks.
# Prefer environment variables for real CI/release usage.
# maven_url = "https://maven.example.com/releases"
# maven_user = ""
# maven_password = ""
# Legacy flat token keys are still accepted:
# modrinth_token = ""
# curseforge_token = ""

# Platform-local token keys are also accepted and keep credentials close to
# the matching project id in project.toml.
# [publish.modrinth]
# token = ""
#
# [publish.curseforge]
# token = ""
